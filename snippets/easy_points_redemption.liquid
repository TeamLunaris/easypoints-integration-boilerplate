{%- comment -%} START EASYPOINTS - DO NOT MODIFY! 変更しないでください! INFO @ https://bit.ly/2Dn7ESM {%- endcomment -%}
{%- assign shop_ep_metafield = shop.metafields.loyalty.easy_points_attributes.value -%}
{%- unless shop_ep_metafield.stealth_mode -%}
  {%- if customer -%}
    {%- liquid
      assign total_balance = customer.metafields.loyalty.easy_points_attributes.value.balance | default: 0
      assign bonus_balance = customer.metafields.loyalty.bonus_balance.value.amount | default: 0
      assign regular_balance = total_balance | minus: bonus_balance

      assign class_button = class_button | default: 'button'
    -%}
    <epi-redemption-form>
      <div class="easy-points-form__container">
        <div class="easy-points-form__balance">
        {%- if bonus_balance > 0 -%}
          {%- capture regular_balance_html -%}
            <span data-loyal-target="regular-balance">{% render 'epi_format_number', number: regular_balance %}</span>
          {%- endcapture -%}

          {%- capture bonus_balance_html -%}
            <span data-loyal-target="gift-balance">{% render 'epi_format_number', number: bonus_balance %}</span>
          {%- endcapture -%}

          {{ 'easypoints.redemption_regular_points_html' | t: points: regular_balance_html }}

          <span style="display: inline-block; vertical-align: top; margin-top: 1px; margin-right: 4px;">
            {% render 'epi_icons', icon: 'gift-points', size: 14 %}
          </span>{{ 'easypoints.redemption_html' | t: points: bonus_balance_html }}
        {%- else -%}
          {%- capture balance -%}
            <span data-loyal-target="balance">{% render 'epi_format_number', number: total_balance %}</span>
          {%- endcapture -%}

          {{ 'easypoints.redemption_html' | t: points: balance }}
        {%- endif -%}
        </div>

        <div class="easy-points-form__inner">
          <div class="easy-points-form__input">
            <div class="easy-points-form__discount hidden-unless-discount-applied easy-points-hide">
              -&nbsp;<span data-loyal-target="applied-discount"></span>
            </div>
            <input type="number" name="redemption_point_value" min="0" autocomplete="off">
          </div>

          <button class="easy-points-button__redeem {{ class_button }}" type="button">
            {{ 'easypoints.cart_redeem' | t }}
          </button>

          <button class="easy-points-button__reset {{ class_button }} easy-points-hide" type="button">
            {{ 'easypoints.cart_reset' | t }}
          </button>
        </div>

        <epi-error-line data-error-type="redemption" class="easy-points-form__errors" />
      </div>
    </epi-redemption-form>
  {%- endif -%}
{%- endunless -%}
{%- comment -%} END EASYPOINTS {%- endcomment -%}
