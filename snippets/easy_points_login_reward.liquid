{%- comment -%} START EASYPOINTS - DO NOT MODIFY! 変更しないでください! INFO @ https://bit.ly/2Dn7ESM {%- endcomment -%}
{%- unless shop.metafields.loyalty.easy_points_attributes.value.stealth_mode
  and shop.metafields.loyalty.easy_points_attributes.rewards.login_reward
-%}
  {%- if customer -%}
    {%- liquid
      assign login_reward_rules = shop.metafields.loyalty.easy_points_attributes.value.reward_rules.login.reward_point_rules
      assign customer_tier_uid = customer.metafields.loyalty.easy_points_attributes.value.tier_uid

      assign login_reward_amount = login_reward_rules[0].point_value | default: 0
      for rule in login_reward_rules
        if rule.uid == customer_tier_uid
          assign login_reward_amount = rule.point_value | default: 0
          break
        endif
      endfor

      assign next_login_reward = customer.metafields.loyalty.next_login_reward.value
    -%}

    {%- capture login_reward -%}
      {
        "nextTimestamp": {{ next_login_reward | json }},
        "pointValue": {{ login_reward_amount | json }}
      }
    {%- endcapture -%}

    {%- capture login_reward_i18n -%}
      {
        "submitAction": {{ "easypoints.login_rewards.submit_action" | t: points: login_reward_amount | json }},
        "success": {{ "easypoints.login_rewards.success" | t | json }},
        "countdown": {{ "easypoints.login_rewards.countdown" | t | json }},
        "locale": {{ request.locale.iso_code | json }}
      }
    {%- endcapture -%}

    <epi-login-reward
      data-reward="{{ login_reward | strip_newlines | strip | escape }}"
      data-i18n="{{ login_reward_i18n | strip_newlines | strip | escape }}"
    >
      <div class="epi-rewards-login__header">
        <h2>
          {{ 'easypoints.login_rewards.heading' | t }}
        </h2>

        <p>
          {{ 'easypoints.login_rewards.description' | t: points: login_reward_amount }}
        </p>
      </div>

      <div class="epi-rewards-login__content">
        <button
          disabled
          type="button"
          class="button"
          data-loyalty-target="login-reward-submit"
        >
          {{ 'easypoints.login_rewards.submit_action' | t: points: login_reward_amount }}
        </button>

        <div
          style="display: none;"
          data-loyalty-target="login-reward-countdown"
        ></div>
      </div>

      <epi-error-line
        data-error-type="login_rewards"
        data-translation-selector='[data-loyalty-login-reward-block="i18n"]'
        class="epi-rewards-login__error"
      ></epi-error-line>
    </epi-login-reward>

    <script data-loyalty-login-reward-block="i18n" type="application/json">
      {
        "errors": {
          "unknown_error": {{ 'easypoints.login_rewards.error' | t | json }}
        }
      }
    </script>
  {%- endif -%}
{%- endunless -%}
{%- comment -%} END EASYPOINTS {%- endcomment -%}
